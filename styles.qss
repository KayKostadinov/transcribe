
QWidget {
    background-color: #44A9F8;
    font-size: 16px;
    font-family: Roboto;
    color: white;
}

QPushButton {
    background-color: #ffa000;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    text-align: center;
    text-decoration: none;
    font-size: 16px;
    font-family: Roboto;
    font-weight: 900;
}

QTextEdit {
    background-color: #3E4C5D;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-size: 16px;
    font-family: Roboto;
}

QLineEdit {
    outline: none;
    border: none;
    border-radius: 10px;
    padding: 10px;
    background-color: #3E4C5D;
}
